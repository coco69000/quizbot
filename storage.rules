rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /quiz_images/{userId}/{fileName} {
      // Seuls les utilisateurs connectés peuvent uploader
      allow read: if request.auth != null;
      
      // Limitation stricte pour l'upload :
      // 1. Doit être authentifié
      // 2. Taille max 5 Mo (5 * 1024 * 1024)
      // 3. Extension de fichier valide (jpg, png, webp, etc.)
      allow write: if request.auth != null 
                   && request.resource.size < 5 * 1024 * 1024 
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
