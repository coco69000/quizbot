rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fonction utilitaire pour vérifier si l'utilisateur est connecté
    function isAuthenticated() {
      return request.auth != null;
    }

    // Fonction pour vérifier si l'utilisateur est l'hôte de la salle
    function isHost(roomId) {
      let room = get(/databases/$(database)/documents/onlineRooms/$(roomId)).data;
      return room.hostUid == request.auth.uid || (request.auth.token.name != null && room.players[request.auth.token.name].isHost == true);
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      // Un utilisateur ne peut modifier que son propre profil, et ne peut pas s'attribuer de VIP, score, iq, ou badges manuellement
      allow update: if isAuthenticated() && request.auth.uid == userId 
                   && !request.resource.data.keys().hasAny(['isVip', 'score', 'iq', 'badges']); 
      allow create: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.score == 0
                    && request.resource.data.iq == 100
                    && request.resource.data.isVip == false;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    match /onlineRooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      
      allow update: if isAuthenticated() && (
        // 1. Seul l'hôte peut modifier l'état global de la partie (démarrer, avancer, fermer)
        (isHost(roomId) && request.resource.data.keys().hasAny(['started', 'active', 'gameState', 'countdownStartTime'])) ||
        // 2. Un joueur ne peut modifier QUE sa propre entrée dans 'players' (pour se connecter/se déconnecter)
        // Il ne peut PAS modifier son score, ni celui des autres.
        (request.resource.data.keys().hasOnly(['players']) && 
         request.resource.data.players.keys().hasOnly([request.auth.token.name]) &&
         request.resource.data.players[request.auth.token.name].keys().hasOnly(['isHost', 'score', 'uid']) &&
         request.resource.data.players[request.auth.token.name].score == resource.data.players[request.auth.token.name].score)
      );
      allow delete: if isAuthenticated();
    }

    match /quizzes/{quizId} {
      allow read: if true; // Les quiz publics sont lisibles par tous
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /userGameHistory/{historyId} {
      // Personne ne peut écrire directement ici, seule la Cloud Function le peut
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; 
    }

    match /userStats/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false; // Seule la Cloud Function met à jour les stats
    }

    match /friendRequests/{reqId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
